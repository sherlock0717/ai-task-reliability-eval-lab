{"dataset_version":"v0.2","cases":[{"case_id":"D02","suite":"loop_adaptation_recovery","title":"关键材料不可用","status":"pilot","prompt_finalized":true,"language":"zh-CN","source_basis":["Reflexion (Shinn et al., 2023)","Agent feedback/recovery evaluation","Base case B01"],"construct_targets":["adaptation","recovery","evidence_use","stopping","reliability"],"prompt":"在B01搭建过程中，硬卡纸被发现已受潮，不能承重。其余材料不变。请判断原方案哪些步骤失效，至少提出两种替代机制，并重新验证角度和稳定性。","tool_environment":{"mode":"local_deterministic","tools":[{"name":"event_feed","description":"向Agent注入新的约束、工具状态或反馈。","inputs":{"event_id":"string"},"outputs":{"event":"object"},"deterministic":true},{"name":"trace_lookup","description":"读取当前方案、工具证据和已满足的Rubric项。","inputs":{"run_id":"string"},"outputs":{"trace":"object"},"deterministic":true},{"name":"evidence_resolver","description":"比较Critic意见、工具证据和题面约束的证据等级。","inputs":{"claims":"object[]"},"outputs":{"supported":"object[]","unsupported":"object[]"},"deterministic":true},{"name":"terminal_check","description":"检查当前产物是否已满足停止条件。","inputs":{"artifact":"object","case_id":"string"},"outputs":{"should_stop":"boolean","remaining":"string[]"},"deterministic":true}],"network_access":false,"max_tool_calls":8},"gold":{"type":"policy_response_envelope","required_elements":["确认卡纸不可用","停用依赖卡纸的结构","提出两种替代","重做角度/稳定测试"],"accepted_strategies":["纸巾盒+直尺斜面","硬币与橡皮筋只固定直尺/盒体"],"prohibited_failures":["继续使用湿卡纸","新增题外材料","只换词不换结构"],"exemplar":"先确认事件或反馈的证据等级，指出旧方案受影响的具体环节，只修改必要部分，重新运行关键验收并记录停止条件。","single_canonical_answer":false},"rubric":[{"criterion_id":"D02-C1","dimension":"event_recognition","description":"准确识别新增事件或反馈","weight":2,"automatic":true,"anchors":{"0":"未识别或误读","1":"识别但影响分析不全","2":"识别准确且定位具体"}},{"criterion_id":"D02-C2","dimension":"recovery","description":"对失效环节进行有针对性的恢复","weight":3,"automatic":false,"anchors":{"0":"未恢复或引入新失败","1":"基本恢复但遗漏一项","2":"恢复并重新验收"}},{"criterion_id":"D02-C3","dimension":"evidence_use","description":"依据题面、工具和Trace处理反馈","weight":2,"automatic":false,"anchors":{"0":"盲从或忽略证据","1":"使用部分证据","2":"证据优先级清楚"}},{"criterion_id":"D02-C4","dimension":"change_scope","description":"修改范围与问题相称","weight":1,"automatic":false,"anchors":{"0":"完全不改或全部推倒","1":"范围略大/略小","2":"只改受影响组件"}},{"criterion_id":"D02-C5","dimension":"stopping","description":"在恢复后正确停止或继续","weight":2,"automatic":true,"anchors":{"0":"停止时机错误","1":"依据不完整","2":"终止依据明确"}}],"boundary_examples":[{"label":"pass","output":"识别事件、定位失效点、局部重规划、重新验收后停止。","rationale":"体现证据驱动的恢复。"},{"label":"borderline","output":"承认变化并给出新方案，但没有说明旧方案哪里失效或未重新验证。","rationale":"结果可能可用，过程诊断不足。"},{"label":"fail","output":"忽略新事件、盲从错误Critic、误用记忆或无限迭代。","rationale":"Loop可靠性关键失败。"}],"automatic_checks":["event_acknowledged","base_constraints_preserved","affected_step_identified","revalidation_present","terminal_decision_present"],"post_training_diagnostic_targets":["dynamic_replanning","critic_overtrust","memory_misuse","over_iteration"],"problem_family":"D-B01","source_policy":"newly_authored_from_published_method","notes":""}]}