{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative Agent Evaluation Case",
  "type": "object",
  "required": ["case_id", "suite", "title", "status", "prompt_finalized", "source_basis", "construct_targets", "prompt", "tool_environment", "gold", "rubric", "boundary_examples", "automatic_checks", "post_training_diagnostic_targets", "problem_family", "source_policy"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-D][0-9]{2}$"},
    "suite": {"enum": ["psychometric_probe", "creative_problem_solving", "creative_artifact", "loop_adaptation_recovery"]},
    "title": {"type": "string", "minLength": 2},
    "status": {"enum": ["specification", "pilot", "frozen", "retired"]},
    "prompt_finalized": {"type": "boolean"},
    "language": {"type": "string"},
    "source_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "construct_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prompt": {"type": "string", "minLength": 40},
    "tool_environment": {"type": "object", "required": ["mode", "tools", "network_access", "max_tool_calls"]},
    "gold": {"type": "object", "required": ["type", "required_elements", "accepted_strategies", "prohibited_failures", "exemplar", "single_canonical_answer"]},
    "rubric": {"type": "array", "minItems": 4},
    "boundary_examples": {"type": "array", "minItems": 3},
    "automatic_checks": {"type": "array", "minItems": 3},
    "post_training_diagnostic_targets": {"type": "array", "minItems": 2},
    "problem_family": {"type": "string"},
    "source_policy": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
